# Copy to .env and fill in what you need. .env is git-ignored; never commit real keys.
# Everything works without a .env: compose.yaml has safe local defaults for all non-secret values.
# Each service receives only the variables it needs (see compose.yaml).

# --- Runtime flags -----------------------------------------------------------------------
ENVIRONMENT=dev                 # dev | test | ci | prod
LOG_LEVEL=INFO
REPLAY_MODE=false               # true = recorded audio/transcripts instead of paid providers
LANG_STRATEGY=hybrid            # translate | native | hybrid
DAILY_BUDGET_USD=5              # checked before every paid provider call; 0 = no paid calls
# Shared secret for service-to-service calls (web -> orchestrator/gateway). Change outside dev.
INTERNAL_API_KEY=dev-internal-key

# --- Postgres (pgvector) and Redis ----------------------------------------------------------
POSTGRES_USER=voiceserve
POSTGRES_PASSWORD=voiceserve
POSTGRES_DB=voiceserve

# --- Host ports (change if something else on your machine already uses them) --------------
DB_HOST_PORT=5433
REDIS_HOST_PORT=6380
LIVEKIT_HTTP_PORT=7880
MINI_UMS_API_PORT=8001
ORCHESTRATOR_PORT=8002
GATEWAY_PORT=8003
WIDGET_PORT=4100
MINI_UMS_WEB_PORT=3000
DASHBOARD_PORT=3001

# --- Realtime audio (LiveKit) ----------------------------------------------------------------
# Local dev uses the self-hosted dev server in compose (placeholder keys devkey/secret).
# For LiveKit Cloud, set the URL and keys from your project settings.
LIVEKIT_NODE_IP=127.0.0.1
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Providers (M3 choices in docs/decisions.md D-027; every provider sits behind an interface)
# Without keys everything still runs: intent falls back to free rules, voice is text-only.
LLM_PROVIDER=                   # empty = anthropic when a key is set, else rules | anthropic | rules
LLM_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
STT_PROVIDER=
TTS_PROVIDER=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
SARVAM_API_KEY=

# --- Observability (decided in M3) ------------------------------------------------------------
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
